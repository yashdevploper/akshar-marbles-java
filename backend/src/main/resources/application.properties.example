# ===============================================================
# Akshar Marbles Backend Configuration Template
# Copy this file to application.properties and provide your local credentials.
# In production on Render, these are overridden by environment variables:
#   DB_URL, DB_USERNAME, DB_PASSWORD, APP_ENVIRONMENT, etc.
# ===============================================================

# Database Connection (MySQL / MariaDB)
# Local: jdbc:mysql://localhost:3306/akshar_marbles?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Kolkata&useSSL=false&allowPublicKeyRetrieval=true
# Remote (e.g. Aiven, Clever Cloud, Railway):
#   Set environment variable DB_URL (or DATABASE_URL / MYSQL_URL)
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/akshar_marbles?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Kolkata&useSSL=false&allowPublicKeyRetrieval=true
db.username=root
db.password=

# HikariCP Connection Pool Settings (Defaults: 10 local dev, 5 on Render 512MB)
hikari.maximumPoolSize=10
hikari.minimumIdle=2
hikari.idleTimeout=30000
hikari.connectionTimeout=20000
hikari.maxLifetime=1800000

# Hibernate ORM Settings
# Leave dialect as "auto" so Hibernate 6 auto-detects MySQLDialect or MariaDBDialect
hibernate.dialect=auto
hibernate.hbm2ddl.auto=validate
hibernate.show_sql=false
hibernate.format_sql=false

# Application Settings
app.environment=development
app.tax.gstRate=0.18
app.shipping.freeThreshold=25000.00
app.shipping.flatRate=1500.00
app.auth.sessionTimeoutMinutes=120
app.auth.rateLimitMaxAttempts=5
app.auth.rateLimitWindowMinutes=15
